<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Contact &amp; Feedback | Romania on Stamps</title>
<meta name="description" content="Contact the author of Romania on Stamps. Send philatelic comments, questions and suggestions.">
<link rel="canonical" href="https://www.marci-postale.com/feedback.asp">
<style>
:root{color-scheme:light}*{box-sizing:border-box}body{margin:0;background:#f5f0e7;color:#263547;font:16px/1.65 Arial,Helvetica,sans-serif}header{background:#263b53;color:#fff;padding:26px 18px;text-align:center}header a{color:#fff;text-decoration:none}header .brand{font:700 clamp(24px,4vw,36px) Georgia,serif;letter-spacing:.2px}nav{margin-top:12px}nav a{margin:0 10px;text-decoration:underline;text-underline-offset:3px}main{width:min(780px,calc(100% - 28px));margin:32px auto 50px;background:#fffdf8;border:1px solid #e2d8c9;border-radius:10px;box-shadow:0 6px 28px #29384b12;padding:clamp(22px,5vw,44px)}h1{font:700 clamp(28px,4vw,39px)/1.2 Georgia,serif;color:#263b53;margin:0 0 14px}.intro{margin-bottom:28px}.ro{color:#5d6570;font-size:.93em}label{display:block;font-weight:700;margin:20px 0 6px}label span{display:block;font-weight:400;color:#69717c;font-size:.88em}input[type=text],input[type=email],select,textarea{width:100%;padding:12px 13px;font:inherit;border:1px solid #bcb8b0;border-radius:6px;background:#fff;color:#263547}textarea{min-height:155px;resize:vertical}.fields{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.captcha{margin:26px 0;padding:17px;background:#f4f1ea;border-radius:8px}.captcha img{display:block;margin:12px 0;max-width:100%;height:auto}.captcha a{font-size:.9em}button{border:0;border-radius:6px;background:#263b53;color:#fff;padding:12px 24px;font:700 16px Arial;cursor:pointer}button:hover{background:#375675}footer{text-align:center;color:#6a6d70;font-size:13px;padding:0 15px 30px}@media(max-width:580px){.fields{grid-template-columns:1fr}main{margin-top:18px}}
</style>
<script>
function reloadCaptcha(){var i=document.getElementById('CaptchaImage');i.src='https://www.snaphost.com/captcha/CaptchaImage.aspx?id=PWGYK9DCQNND&ImgType=2&d='+Date.now();return false;}
function checkFeedback(f){if(!f.skip_CaptchaCode.value.trim()){alert('Please enter the verification code. / Introduceți codul de verificare.');f.skip_CaptchaCode.focus();return false;}return true;}
</script>
</head>
<body>
<header><div class="brand"><a href="index.html">Romania on Stamps</a></div><nav aria-label="Site navigation"><a href="index.html">Home / Acasă</a></nav></header>
<main>
<h1>Contact &amp; Feedback</h1>
<p class="intro">Your questions, comments and suggestions about Romanian philately and this website are welcome.<br><span class="ro" lang="ro">Întrebările, comentariile și sugestiile dumneavoastră despre filatelia românească și acest site sunt binevenite.</span></p>
<form action="https://www.SnapHost.com/captcha/send.aspx" method="post" onsubmit="return checkFeedback(this)" id="ContactUsCaptchaWebForm" target="_top">
<input type="hidden" name="skip_WhereToSend" value="victor.manta@gmail.com">
<input type="hidden" name="skip_SnapHostID" value="PWGYK9DCQNND">
<input type="hidden" name="skip_WhereToReturn" value="https://www.marci-postale.com/feedback-confirm.htm">
<input type="hidden" name="skip_Subject" value="Romania on Stamps - Contact / Feedback">
<input type="hidden" name="skip_ShowUsersIp" value="1">
<input type="hidden" name="skip_SendCopyToUser" value="1">
<div class="fields">
<div><label for="name">Name * <span lang="ro">Nume *</span></label><input id="name" name="Name" type="text" maxlength="120" autocomplete="name" required></div>
<div><label for="email">Email * <span lang="ro">Adresă de e-mail *</span></label><input id="email" name="Email" type="email" maxlength="200" autocomplete="email" required></div>
</div>
<label for="topic">Subject <span lang="ro">Subiect</span></label><select id="topic" name="Subject"><option value="Philatelic question">Philatelic question / Întrebare filatelică</option><option value="Website correction">Website correction / Corecție pe site</option><option value="Suggestion">Suggestion / Sugestie</option><option value="Other">Other / Altceva</option></select>
<label for="message">Message * <span lang="ro">Mesaj *</span></label><textarea id="message" name="Message" maxlength="10000" required></textarea>
<div class="captcha"><label for="code">Verification code * <span lang="ro">Cod de verificare *</span></label><img id="CaptchaImage" src="https://www.SnapHost.com/captcha/CaptchaImage.aspx?id=PWGYK9DCQNND&amp;ImgType=2" alt="Verification image with six-character code"><a href="#" onclick="return reloadCaptcha()">Reload image / Reîncarcă imaginea</a><input id="code" name="skip_CaptchaCode" type="text" maxlength="6" autocomplete="off" required></div>
<button type="submit" name="skip_Submit" value="Submit">Send message / Trimite mesajul</button>
</form>
</main>
<footer>Romania on Stamps · Contact &amp; Feedback</footer>
</body></html>
